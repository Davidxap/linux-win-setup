# Forzar GPU AMD en high performance desde el kernel - evita stutter/freeze en Wayland
# Safety net: si gpu-performance.service falla, esto ya puso la GPU en high
KERNEL=="card[0-9]", SUBSYSTEM=="drm", DRIVERS=="amdgpu", RUN+="/bin/sh -c 'echo high > /sys/class/drm/%k/device/power_dpm_force_performance_level 2>/dev/null'"
